{
  "name": "secure-pastebin-cloudflare-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-encrypted, expiring message sharing on Cloudflare Workers and D1",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run typecheck && npm test",
    "deploy": "npm run db:remote && wrangler deploy",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "miniflare": "5.20260930.0-alpha",
    "typescript": "7.0.2",
    "wrangler": "4.145.0"
  }
}
